[gd_resource type="Resource" script_class="AffixDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://simulation/affix/AffixDef.gd" id="1_aff"]
[ext_resource type="Script" path="res://simulation/affix/TriggerDef.gd" id="2_trg"]
[ext_resource type="Script" path="res://simulation/affix/EffectDef.gd" id="3_eff"]

[sub_resource type="Resource" id="Resource_trg"]
script = ExtResource("2_trg")
event_type = 2 ; 来源: 02号文件 §6.2 杀戮狂热 — 击杀(KILL)触发
mode = 0 ; ALWAYS
threshold = 1
chance = 1.0
icd_ticks = 0

[sub_resource type="Resource" id="Resource_eff"]
script = ExtResource("3_eff")
vfx_key = "killing_frenzy"
should_emit_event = false
apply_buff_key = "killing_frenzy"
buff_duration_ticks = 20 ; 来源: 02号文件 §6.2 — 2 秒无击杀清零 (10Hz = 20 tick)
buff_max_stacks = 10 ; 来源: 02号文件 §6.2 — 最多 10 层
buff_stat = "atk_speed_pct"
buff_val_per_stack = 0.15 ; 来源: 02号文件 §6.2 — 攻速 +15%/层

[resource]
script = ExtResource("1_aff")
id = "killing_frenzy"
name = "杀戮狂热"
desc_template = "击杀后叠加攻速增益，无击杀超时清零"
is_passive = false
trigger = SubResource("Resource_trg")
effect = SubResource("Resource_eff")
counter_tags = Array[String](["multi_hit", "high_atk_speed", "fast_kill"]) ; 来源: 02号文件 §6.2 克制标签
budget_per_tick = 10 ; 来源: 02号文件 §2.3 — 每词条每 tick 预算
