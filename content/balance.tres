[gd_resource type="Resource" script_class="Balance" load_steps=2 format=3]

[ext_resource type="Script" path="res://simulation/Balance.gd" id="1_balance"]

[resource]
script = ExtResource("1_balance")
; --- 1. 基础战斗与单次伤害模型 (来源: 02号文件 §1.2 & 00号文件 §2 E10) ---
base_atk_interval = 0.5 ; 来源: 02号文件 §1.2 (基础攻击间隔 0.5s = 2.0次/秒)
min_atk_interval = 0.01 ; 来源: 02号文件 §1.2 & Q6 (攻击间隔安全下限)
base_crit_rate = 0.05 ; 来源: 02号文件 §1.2 (初始暴击率 5%)
crit_rate_cap = 0.75 ; 来源: 02号文件 §1.2 (暴击率上限 75%)
base_crit_mult = 1.5 ; 来源: 02号文件 §1.2 (基础暴击倍率 1.5x)
b0_atk_log = 2.0 ; 来源: 02号文件 §1.2 (初始基础攻击 B0=100, log10=2.0)
beta_atk_log = 0.06818586 ; 来源: 02号文件 §1.2 & §9.2 Gate-1 R1 校准 (金币攻击每级成长 log10, 原 0.05690485)
c0_cost_log = 3.3 ; 来源: 02号文件 §1.2 & §9.2 Gate-1 R2 校准 (初始升级花费 log10, 原 1.0 -> R1 3.05)
gamma_cost_log = 0.06818586 ; 来源: 02号文件 §1.2 (升级花费增长 γ=1.17, log10(1.17))
eq_phi_min = 0.3 ; 来源: 02号文件 §1.2 (装备基础平值系数 φ 下限)
eq_phi_max = 1.0 ; 来源: 02号文件 §1.2 (装备基础平值系数 φ 上限)
eq_g_log = 0.145 ; 来源: 02号文件 §1.2 & §9.2 Gate-1 R1 校准 (装备 iLvl 指数成长 log10, 原 0.14612803)
gear_additive_pct_blue = 0.15 ; 来源: 02号文件 §1.2 (蓝装加法区百分比上限)
gear_additive_pct_purple = 0.4 ; 来源: 02号文件 §1.2 (紫装加法区百分比上限)
gear_additive_pct_unique = 0.8 ; 来源: 02号文件 §1.2 (暗金加法区百分比上限)
gear_additive_pct_primal = 1.2 ; 来源: 02号文件 §1.2 & §1.7 (太古满 roll 加法区百分比)
unique_mult_min = 1.8 ; 来源: 02号文件 §1.2 & §9.2 Gate-1 R1 校准 (暗金独立乘区单件下限, 原 1.5)
unique_mult_max = 3.6 ; 来源: 02号文件 §1.2 & §9.2 Gate-1 R1 校准 (暗金独立乘区单件上限, 原 3.0)
equip_slot_count = 6 ; 来源: 00号文件 §2 E10 & 02号文件 §1.2 (6槽位 weapon/helm/chest/gloves/boots/trinket)
e0_income_log = 0.5 ; 来源: 02号文件 §1.2 & §5.1 & §9.2 Gate-1 R1 校准 (单怪金币基数 log10, 原 1.0)
income_stage_log = 0.196 ; 来源: 02号文件 §1.2 & §5.1 & §9.2 Gate-1 R1 校准 (每层单怪金币增长 log10, 原 0.17609126)
expected_kills_per_min = 50.0 ; 来源: 02号文件 §1.2 & §5.1 (设计期望每分钟等效击杀数 50)
; --- 2. 怪物血量曲线与推层规则 (来源: 02号文件 §1.3 & §0 Q3 & 00号文件 E3) ---
h0_hp_log = 2.17609126 ; 来源: 02号文件 §1.3 (初始血量基数 log10(150))
hp_linear_coeff = 0.2 ; 来源: 02号文件 §1.3 (h(s) 线性项系数 0.2)
hp_quad_coeff = 0.0005 ; 来源: 02号文件 §1.3 (h(s) 二次项系数 a=0.0005)
boss_hp_mult_log = 1.0 ; 来源: 02号文件 §1.3 (Boss 血量 ×10 = +1.0 log10)
boss_time_limit = 15.0 ; 来源: 02号文件 §0 Q3 & §1.3 (Boss 战限时 15 秒)
mobs_per_stage = 10 ; 来源: 02号文件 §0 Q3 & §1.3 (每层小怪数 10 只)
farm_retry_kills = 20 ; 来源: 02号文件 §0 Q3 & 00号文件 E3 (刷怪层周期自动重试击杀数)
; --- 3. 灵魂转生、深渊印记与自动转生 (来源: 02号文件 §1.4–§1.6) ---
soul_start_stage = 50 ; 来源: 02号文件 §1.4 (灵魂产出起始层数 50)
soul_k_coeff = 0.032 ; 来源: 02号文件 §1.4 & §9.2 Gate-1 R3 校准 (灵魂指数系数, 原 0.05)
soul_dmg_per_unit = 0.1 ; 来源: 02号文件 §1.2 & §1.4 (灵魂乘区系数 0.1: log10(1+0.1*souls))
mark_k_amp_per_mark = 1.15 ; 来源: 02号文件 §1.5 & §9.2 Gate-1 R3 校准 (印记放大灵魂指数系数, 原 0.2 -> R1 0.75)
mark_stage_divisor = 50.0 ; 来源: 02号文件 §1.5 & §9.2 Gate-1 R3 校准 (印记层数分母, 原 100.0 -> R1 60.0)
mark_stage_exponent = 0.85 ; 来源: 02号文件 §1.5 & §9.2 Gate-1 R1 校准 (印记层数次线性幂指数, 原 1.5)
vault_base_slots = 1 ; 来源: 02号文件 §1.5 (永久威能基础槽位数 1)
vault_marks_per_extra_slot = 5 ; 来源: 02号文件 §1.5 (每 5 枚印记 +1 永久威能槽)
auto_prestige_min_run_seconds = 1800.0 ; 来源: 02号文件 §1.6 (自动转生最小保护时长 30 分钟)
auto_prestige_rate_drop_ratio = 0.95 ; 来源: 02号文件 §1.6 & §9.2 Gate-1 R3 校准 (灵魂获取速率越过峰值回落判据 0.95)
; --- 4. 掉落、MF、保底、熔炼与背包 (来源: 02号文件 §1.7 & §0 Q12–Q13) ---
drop_base_per_kill = 1.2 ; 来源: 02号文件 §1.7 (每次击杀基础掉落件数 1.2)
boss_drop_base_count = 3 ; 来源: 02号文件 §1.7 (Boss 击杀基础掉落件数 3)
drop_max_per_kill = 30 ; 来源: 02号文件 §1.7 (单次击杀掉落上限 30 件)
rarity_weight_white = 70.0 ; 来源: 02号文件 §1.7 (白装品质权重 70)
rarity_weight_blue = 22.0 ; 来源: 02号文件 §1.7 (蓝装品质权重 22)
rarity_weight_purple = 7.0 ; 来源: 02号文件 §1.7 (紫装品质权重 7)
rarity_weight_unique = 0.42 ; 来源: 02号文件 §1.7 & §9.2 Gate-1 R2 校准 (暗金品质权重, 原 0.9 -> R1 0.24)
rarity_weight_primal = 0.02 ; 来源: 02号文件 §1.7 & §9.2 Gate-1 R1 校准 (太古绯红品质权重, 原 0.1)
mf_diminish_k = 250.0 ; 来源: 02号文件 §1.7 (D2 递减常数 MF*250/(MF+250))
unique_pity_kills = 140 ; 来源: 02号文件 §1.7 (连续 140 次击杀暗金保底)
primal_bonus_ilvl = 5 ; 来源: 02号文件 §1.7 (太古绯红额外 +5 iLvl)
primal_extra_affixes = 1 ; 来源: 02号文件 §1.7 (太古绯红额外 +1 词条)
inventory_max_slots = 24 ; 来源: 02号文件 §0 Q13 (背包上限 24 格)
score_rarity_weight = 1000.0 ; 来源: 02号文件 §0 Q13 (背包淘汰评分品质权重)
score_ilvl_weight = 10.0 ; 来源: 02号文件 §0 Q13 (背包淘汰评分 iLvl 权重)
smelt_mult_white_log = 0.0 ; 来源: 02号文件 §1.7 (白装熔炼金币倍率 1.0x)
smelt_mult_blue_log = 0.39794001 ; 来源: 02号文件 §1.7 (蓝装熔炼金币倍率 2.5x)
smelt_mult_purple_log = 0.90308999 ; 来源: 02号文件 §1.7 (紫装熔炼金币倍率 8.0x)
smelt_mult_unique_log = 1.47712125 ; 来源: 02号文件 §1.7 (暗金熔炼金币倍率 30.0x)
smelt_mult_primal_log = 2.0 ; 来源: 02号文件 §1.7 (太古熔炼金币倍率 100.0x)
manual_pickup_bonus_rate = 0.1 ; 来源: 02号文件 §0 Q12 & §3.3 (手动划过拾取 +10% 金币)
; --- 5. 模拟时钟、混合粒度结算与防递归上限 (来源: 02号文件 §0 Q5–Q7, §2.3, §3.2) ---
sim_tick_dt = 0.1 ; 来源: 02号文件 §0 Q5 & §3.2 (10Hz 固定模拟步长 0.1s)
max_catchup_ticks = 50 ; 来源: 02号文件 §3.2 & 00号文件 WP-03 (最多追赶 50 个 tick)
hybrid_individual_attacks = 8 ; 来源: 02号文件 §0 Q6 & 00号文件 WP-03 (前 8 次逐击结算)
max_kills_per_tick = 20 ; 来源: 02号文件 §0 Q6 & 00号文件 WP-03 (每 tick 最多击杀 20 只)
resolver_max_depth = 4 ; 来源: 02号文件 §0 Q7 & §2.3 (派生事件最大深度 4)
resolver_max_events_per_tick = 256 ; 来源: 02号文件 §2.3 (全局每 tick 事件上限 256)
resolver_max_spill = 512 ; 来源: 02号文件 §2.3 (溢出压缩上限 512)
event_compact_threshold = 64 ; 来源: 02号文件 §2.3 (事件队列压缩阈值 64)
overflow_reward_offset_log = -1.0 ; 来源: 02号文件 §2.3 (超深度转化保底金币 ×0.1)
; --- 6. 净财富压力与信贷系统 (来源: 02号文件 §5.1–§5.2 & 00号文件 E4, Q23, Q26, Q35) ---
wealth_pressure_slope = 0.5 ; 来源: 02号文件 §5.1 (W>I 正净财富压力斜率 0.5)
max_wealth_hp_mult_log = 0.47712125 ; 来源: 02号文件 §5.1 & 00号文件 E4 (普通财富压力上限 ×3 = log10(3))
debt_relief_slope = 0.06 ; 来源: 02号文件 §5.1 (W<0 净负债减血斜率 0.06)
min_debt_hp_factor = 0.4 ; 来源: 02号文件 §5.1 & 00号文件 E4 (负债怪物血量最低降至 40%)
min_debt_hp_mult_log = -0.39794001 ; 来源: 02号文件 §5.1 & 00号文件 E4 (负债血量下限 log10(0.4))
credit_limit_base_minutes = 10.0 ; 来源: 02号文件 §5.2 (0级信用基础额度 = 10分钟期望收入)
credit_limit_tier_growth = 1.5 ; 来源: 02号文件 §5.2 (每级信用额度乘数 1.5^tier)
credit_base_mult = 1.1 ; 来源: 02号文件 §5.2 & Q26 (基础还款溢价 1.1x)
credit_quad_coeff = 0.5 ; 来源: 02号文件 §5.2 & Q26 (溢价二次项 0.5*u^2, 借满 1.6x)
repayment_deduction_rate = 0.4 ; 来源: 02号文件 §5.2 & Q26 & Q35 (每笔收入自动扣 40% 还债)
credit_max_concurrent_loans = 1 ; 来源: 02号文件 §5.2 (默认单笔并发借款)
; --- 7. 科技树与离线结算 (来源: 02号文件 §3.4 & §5.3 & Q5 & Q27) ---
tech_base_minutes = 2.0 ; 来源: 02号文件 §5.3 (研究基础时长 2 分钟)
tech_tier_time_growth = 2.2 ; 来源: 02号文件 §5.3 (研究时长指数底数 2.2^tier)
tech_queue_max_slots = 5 ; 来源: 02号文件 §0 Q27 & §5.3 (研究队列 5 格)
auto_buy_max_per_tick = 16 ; 来源: 02号文件 §5.3 自动化分支 (每 tick 自动购买级数上限)
mech_income_ema_new = 0.1 ; 来源: 02号文件 §7.1 吞金 (近期收入滑动平均新样本权重，旧值 0.9)
mech_income_min_interval = 0.5 ; 来源: 02号文件 §7.1 吞金 (单击折算每秒收入的最小间隔)
unique_rain_drop_mult = 10 ; 来源: 02号文件 §2.4 暗金雨 (下一次击杀掉落 ×10)
unique_rain_rarity_floor = 2 ; 来源: 02号文件 §2.4 暗金雨 (品质保底紫装)
abyss_min_stage = 100 ; 来源: 02号文件 §1.5 (深渊转生最低层数)
tech_deep_unlock_tier = 5 ; 来源: 02号文件 §5.3 (深渊印记解锁第 5 层以后节点)
offline_sample_seconds = 60.0 ; 来源: 02号文件 §3.4 第 7 条 (离线 60 秒校准采样)
offline_cap_base_hours = 8.0 ; 来源: 02号文件 §0 Q5 & §3.4 (默认离线上限 8h)
offline_cap_max_hours = 24.0 ; 来源: 02号文件 §0 Q5 & §3.4 & §5.3 (升级后离线上限 24h)
; --- 8. 每 100 层机制变阵、卡墙信号与关卡门票 (来源: 02号文件 §7.1–§7.3 & Q30–Q32, Q36) ---
band_stage_interval = 100 ; 来源: 02号文件 §7.1 & Q31 (每 100 层机制切换与门票分界)
band_lingering_strength = 0.3 ; 来源: 02号文件 §7.1 & Q31 (上一区间机制保留 30% 余韵)
mech_shield_hp_ratio = 0.5 ; 来源: 02号文件 §7.1 (100–199 层护盾量 = 50% 最大生命)
mech_shield_max_hit_strip = 0.1 ; 来源: 02号文件 §7.1 & §9.2 Gate-1 R1 校准 (每次命中最多削护盾上限比例, 原 0.02)
mech_backlash_max_stacks = 40 ; 来源: 02号文件 §7.1 & Q30 (200–299 层反噬满 40 点眩晕)
mech_backlash_stun_seconds = 2.0 ; 来源: 02号文件 §7.1 & Q30 (200–299 层反噬眩晕 2 秒)
mech_crit_only_non_crit_mult = 0.05 ; 来源: 02号文件 §7.1 (300–399 层非暴击伤害 ×0.05)
mech_clone_trigger_hp_ratio = 0.5 ; 来源: 02号文件 §7.1 (400–499 层 Boss 50% 血分裂)
mech_clone_split_count = 4 ; 来源: 02号文件 §7.1 (400–499 层分裂数量 4 个)
mech_gold_eat_balance_rate = 0.01 ; 来源: 02号文件 §7.1 (500–599 层每秒吞掉余额 1%)
mech_gold_eat_income_cap = 0.5 ; 来源: 02号文件 §7.1 (500–599 层吞金上限为收入 50%)
wall_signal_fail_streak = 5 ; 来源: 02号文件 §7.2 (连续 5 次 Boss 失败触发卡墙提示)
toll_expected_income_minutes = 30.0 ; 来源: 02号文件 §7.3 & Q32 (门票价格 = 30 分钟期望收入)
toll_saving_lead_stages = 5 ; 来源: 02号文件 §7.3 & Q36 (门前 5 层以内开启储蓄托管)
; --- 9. 换装干跑 DryRun (来源: 02号文件 §0 Q14 & §2.1) ---
dry_run_seconds = 30.0 ; 来源: 02号文件 §0 Q14 (克隆 Sim 干跑 30 秒)
dry_run_default_seed = 987654321 ; 来源: 02号文件 §2.1 (干跑默认确定性种子)
dry_run_display_cap_log = 5.0 ; 来源: 02号文件 §0 Q14 (Δ% 展示上限 10^5)
